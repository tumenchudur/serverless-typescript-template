# ===========================================
# Production Environment Configuration
# ===========================================
# DO NOT commit actual production values!
# These values should be stored in AWS SSM Parameter Store
# This file shows what parameters are needed

# Stage
STAGE=prod
NODE_ENV=production

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_PROFILE=production

# Database Configuration
# Stored in SSM: /${STAGE}/app/database-url
DATABASE_URL=<stored-in-ssm>

# DynamoDB
ORDERS_TABLE=prod-orders

# Logging
LOG_LEVEL=info
SERVICE_NAME=template-prod

# CORS (Restrict to your domain)
CORS_ORIGIN=https://yourdomain.com

# Cognito (Production Pools)
# USER_POOL_ARN=arn:aws:cognito-idp:ap-southeast-1:123456789:userpool/ap-southeast-1_ProdPool
# ADMIN_POOL_ARN=arn:aws:cognito-idp:ap-southeast-1:123456789:userpool/ap-southeast-1_ProdAdminPool

# VPC Configuration (Stored in SSM)
# /${STAGE}/app/security-group-id
# /${STAGE}/app/subnet-1
# /${STAGE}/app/subnet-2

# ===========================================
# Required SSM Parameters for Production
# ===========================================
# Create these in AWS SSM Parameter Store:
#
# /prod/app/database-url          - PostgreSQL connection string
# /prod/app/security-group-id     - VPC security group ID
# /prod/app/subnet-1              - VPC subnet 1 ID
# /prod/app/subnet-2              - VPC subnet 2 ID
#
# Optional:
# /prod/app/cognito-user-pool-arn - Cognito user pool ARN
# /prod/app/cognito-admin-pool-arn - Cognito admin pool ARN

# ===========================================
# Development Environment Configuration
# ===========================================
# Copy this file to .env.dev and fill in your values
# Usage: source .env.dev && pnpm run deploy:dev

# Stage
STAGE=dev
NODE_ENV=development

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_PROFILE=default

# Database Configuration (Local or Dev RDS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/template_dev

# DynamoDB (Local)
DYNAMODB_ENDPOINT=http://localhost:8000
ORDERS_TABLE=dev-orders

# Logging
LOG_LEVEL=debug
SERVICE_NAME=template-dev

# CORS (Allow all in dev)
CORS_ORIGIN=*

# Cognito (Dev Pool - Optional)
# USER_POOL_ARN=arn:aws:cognito-idp:ap-southeast-1:123456789:userpool/ap-southeast-1_DevPool
# ADMIN_POOL_ARN=arn:aws:cognito-idp:ap-southeast-1:123456789:userpool/ap-southeast-1_DevAdminPool

# Optional: Local Development
# SERVERLESS_OFFLINE_PORT=3000

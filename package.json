{
  "name": "serverless-typescript-template",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready serverless TypeScript monorepo template with DynamoDB and PostgreSQL support",
  "author": "tumenchudur",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tumenchudur/serverless-typescript-template.git"
  },
  "keywords": [
    "serverless",
    "typescript",
    "aws-lambda",
    "monorepo",
    "turborepo",
    "drizzle-orm",
    "dynamodb",
    "postgresql"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.17.1"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint .",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "deploy": "./scripts/deploy.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.31.2",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "turbo": "^2.4.2",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
